  "textureParts": {
    "note": "FlightFactor 777-F (XP12) 按 objects/777/ 下的固定文件名加载 DDS 贴图，与机模自带的 Paint Kit 一致。机身被拆成 1/2/3 三段，另有整张机翼、发动机(GE)与标识/贴纸图层。为每个部位「选择图片…」，程序会把图片转成 DDS DXT5 并放到机模认识的名字（PNG/BMP 自动转换；涂装图标除外）；不选的部位不会生成。",
    "parts": [
      {
        "key": "fuselage1",
        "label": "机身贴图 第 1 段 (fuselage1)",
        "target": "objects/777/77F/fuselage1.dds",
        "help": "777-F 机身三段贴图中的第 1 段（三段合起来覆盖整条机身，分界请对照机模自带的 Paint Kit）。若不单独指定「涂装图标」，打包时会自动用它生成图标。"
      },
      {
        "key": "fuselage2",
        "label": "机身贴图 第 2 段 (fuselage2)",
        "target": "objects/777/77F/fuselage2.dds",
        "help": "777-F 机身三段贴图中的第 2 段。"
      },
      {
        "key": "fuselage3",
        "label": "机身贴图 第 3 段 (fuselage3)",
        "target": "objects/777/77F/fuselage3.dds",
        "help": "777-F 机身三段贴图中的第 3 段。"
      },
      {
        "key": "wings",
        "label": "机翼贴图 (wings)",
        "target": "objects/777/wings.dds",
        "help": "整张机翼贴图（含上下表面）。"
      },
      {
        "key": "engine",
        "label": "发动机贴图 (GE)",
